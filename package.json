{
  "name": "appv4-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:learning",
    "start:learning": "ng serve learning --port 4200",
    "start:admin": "ng serve admin --port 4201",
    "build": "npm run build:learning && npm run build:admin",
    "build:learning": "ng build learning",
    "build:admin": "ng build admin",
    "watch:learning": "ng build learning --watch --configuration development",
    "watch:admin": "ng build admin --watch --configuration development",
    "test": "npm run test:learning && npm run test:admin",
    "test:learning": "ng test learning --watch=false --browsers=ChromeHeadlessCI",
    "test:admin": "ng test admin --watch=false --browsers=ChromeHeadlessCI",
    "lint": "ng lint learning && ng lint admin",
    "lint:learning": "ng lint learning",
    "lint:admin": "ng lint admin",
    "e2e": "playwright test",
    "api:generate": "node scripts/api-generate.mjs",
    "api:check": "node scripts/api-check.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/router": "^22.2.2",
    "bootstrap": "^5.3.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
